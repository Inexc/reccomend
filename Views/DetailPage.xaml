<UserControl x:Class="MovieBookRecommender.Views.DetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MovieBookRecommender.Views"
             Background="{StaticResource BgBrush}"
             RenderTransformOrigin="0.5,0">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageTranslate" X="0" Y="0"/>
    </UserControl.RenderTransform>

    <ScrollViewer x:Name="MainScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="MainScroll_SizeChanged">
        <StackPanel Margin="32,24,32,40">

            <!-- ВЕРХНЯЯ НАВИГАЦИОННАЯ ПАНЕЛЬ С КНОПКОЙ НАЗАД -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка «← Назад» -->
                <Button x:Name="BackBtn" Grid.Column="0"
                        Style="{StaticResource GhostButton}"
                        Padding="14,8"
                        Cursor="Hand"
                        Click="BackBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{StaticResource TextBrush}"
                              Width="11" Height="11" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Назад" FontSize="13" FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Хлебные крошки / путь -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="BreadcrumbSection" Text="КАТАЛОГ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextFaintBrush}"/>
                    <TextBlock Text="  /  " Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextFaintBrush}"/>
                    <TextBlock x:Name="BreadcrumbTitle" Text="НАЗВАНИЕ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ГЛАВНЫЙ КИНЕМАТОГРАФИЧНЫЙ HERO-БЛОК -->
            <Border x:Name="HeroContainer"
                    CornerRadius="16" ClipToBounds="True"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    Margin="0,0,0,32">
                <Grid>
                    <!-- Атмосферный полупрозрачный фон -->
                    <Image x:Name="HeroBackdropImage" Stretch="UniformToFill"
                           Opacity="0.14" HorizontalAlignment="Right" Width="680"/>

                    <!-- Многослойное затемнение в цвета темы -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FC161114" Offset="0"/>
                                <GradientStop Color="#F6161114" Offset="0.45"/>
                                <GradientStop Color="#DC161114" Offset="0.75"/>
                                <GradientStop Color="#B8161114" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Контентное содержимое Hero -->
                    <Grid Margin="32,28,32,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: текстовые метаданные, описание, кнопки -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">

                            <!-- Бэйдж типа и жанры -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Border x:Name="HeroKindBadgeBorder"
                                        Background="#2D2128" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,10,0">
                                    <TextBlock x:Name="HeroKindBadge" Text="ФИЛЬМ"
                                               FontSize="10" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <TextBlock x:Name="HeroGenresText" Text="Фантастика, Драма"
                                           FontSize="12" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Название произведения (крупно, перенос на 2 строки) -->
                            <TextBlock x:Name="HeroTitle"
                                       Text="Название произведения"
                                       FontSize="30" FontFamily="Segoe UI Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="38"
                                       Margin="0,0,0,10"/>

                            <!-- Метаданные (Рейтинг, Год, Режиссёр/Автор) -->
                            <WrapPanel x:Name="HeroMetaPanel" VerticalAlignment="Center" Margin="0,0,0,16">
                                <!-- Рейтинг -->
                                <StackPanel x:Name="HeroRatingGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="★" FontSize="14" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="HeroRatingText" Text="8.7" FontSize="14" FontFamily="Segoe UI Bold"
                                               Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" / 10" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="HeroMetaDot1" Text="•" Foreground="{StaticResource TextFaintBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- Год -->
                                <TextBlock x:Name="HeroYearText" Text="2014 г." FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <TextBlock x:Name="HeroMetaDot2" Text="•" Foreground="{StaticResource TextFaintBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- Автор / Режиссёр -->
                                <TextBlock x:Name="HeroAuthorText" Text="Режиссёр: Кристофер Нолан" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </WrapPanel>

                            <!-- Секция «Описание» -->
                            <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="HeroDescription"
                                       Text="Описание произведения..."
                                       FontSize="13.5" LineHeight="21"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"
                                       MaxHeight="68"
                                       TextTrimming="CharacterEllipsis"/>

                            <Button x:Name="ToggleDescBtn"
                                    Content="Показать полностью ↓"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    FontSize="11.5"
                                    Padding="8,4"
                                    Margin="0,6,0,0"
                                    Click="ToggleDescBtn_Click"/>

                            <!-- Блок кнопок действий -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="PrimaryActionBtn"
                                        Style="{StaticResource AccentButton}"
                                        Padding="22,12"
                                        Content="▷  Смотреть фильм"
                                        Click="PrimaryActionBtn_Click"/>

                                <Button x:Name="FavoriteBtn"
                                        Style="{StaticResource GhostButton}"
                                        Padding="18,12"
                                        Margin="12,0,0,0"
                                        Content="♡  В избранное"
                                        Click="FavoriteBtn_Click"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- Правая колонка: крупный пропорциональный постер с тенью -->
                        <Border Grid.Column="1" x:Name="HeroPosterBorder"
                                Width="216" Height="316"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                CornerRadius="12" ClipToBounds="True"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <Image x:Name="HeroPosterImage" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Height="60"
                                        Background="{StaticResource PosterFadeBrush}" Opacity="0.35"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </Border>

            <!-- СЕКЦИЯ: ДЕТАЛИ -->
            <TextBlock Text="Детали" Style="{StaticResource H2}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="12" Padding="24,20" Margin="0,0,0,32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Колонка 1 -->
                    <StackPanel Grid.Column="0">
                        <!-- Роль создателя -->
                        <StackPanel x:Name="DetailCreatorGroup" Margin="0,0,0,16">
                            <TextBlock x:Name="DetailCreatorLabel" Text="РЕЖИССЁР" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetailCreatorValue" Text="Кристофер Нолан" Style="{StaticResource BodyText}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Год выпуска -->
                        <StackPanel x:Name="DetailYearGroup" Margin="0,0,0,16">
                            <TextBlock Text="ГОД ВЫПУСКА" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetailYearValue" Text="2014 г." Style="{StaticResource BodyText}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Тип произведения -->
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="ТИП ПРОИЗВЕДЕНИЯ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetailKindValue" Text="Художественный фильм" Style="{StaticResource BodyText}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Колонка 2 -->
                    <StackPanel Grid.Column="2">
                        <!-- Жанры -->
                        <StackPanel x:Name="DetailGenresGroup" Margin="0,0,0,16">
                            <TextBlock Text="ЖАНРЫ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetailGenresValue" Text="Фантастика, Драма" Style="{StaticResource BodyText}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Рейтинг -->
                        <StackPanel x:Name="DetailRatingGroup" Margin="0,0,0,16">
                            <TextBlock Text="РЕЙТИНГ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetailRatingValue" Text="★ 8.7 из 10" Style="{StaticResource BodyText}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Статус в избранном -->
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="В ВАШЕЙ КОЛЛЕКЦИИ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="DetailFavoriteStatus" Text="В избранном" Style="{StaticResource BodyText}" FontSize="14" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- СЕКЦИЯ: ПОХОЖИЕ ПРОИЗВЕДЕНИЯ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Похожие произведения" Style="{StaticResource H2}"/>
                    <TextBlock Text="Подобрано на основе жанров, создателя и оценок" Style="{StaticResource SmallText}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Сетка похожих карточек (без горизонтального скролла) -->
            <UniformGrid x:Name="SimilarGrid" Rows="1" Columns="4" Margin="0,0,0,10"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
