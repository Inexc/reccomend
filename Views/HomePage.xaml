<UserControl x:Class="MovieBookRecommender.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,32,48,40">

            <!-- Поиск -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Width="380"
                    HorizontalAlignment="Left" Margin="0,0,0,28">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⌕" FontSize="14" Foreground="{StaticResource TextFaintBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}"
                             KeyDown="SearchBox_KeyDown" Padding="0,12" FontSize="13"/>
                </Grid>
            </Border>

            <!-- Hero + правая колонка -->
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Hero -->
                <Border x:Name="HeroFrame" Grid.Column="0" CornerRadius="16" ClipToBounds="True" Height="420">
                    <Grid>
                        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                        <Border Background="{StaticResource HeroFadeBrush}"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="48,0,0,0" MaxWidth="480">
                            <StackPanel x:Name="HeroGenres" Orientation="Horizontal" Margin="0,0,0,16"/>

                            <TextBlock x:Name="HeroTitle" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock x:Name="HeroAuthor" Style="{StaticResource BodyText}"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="·" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="★" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="HeroRating" Foreground="{StaticResource Accent2Brush}"
                                           FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="HeroDescription" Style="{StaticResource BodyText}"
                                       MaxHeight="68" TextTrimming="CharacterEllipsis" Margin="0,0,0,24"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="HeroPrimaryBtn" Style="{StaticResource AccentButton}"
                                        Margin="0,0,12,0" Click="HeroPrimaryBtn_Click"/>
                                <Button x:Name="HeroFavBtn" Style="{StaticResource GhostButton}"
                                        Click="HeroFavBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Правая колонка -->
                <StackPanel Grid.Column="2">

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ИЗБРАННОЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="FavoritesList"/>
                            <TextBlock x:Name="FavoritesEmptyText" Style="{StaticResource SmallText}"
                                       Text="Добавляйте через ♡" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="ЖАНРЫ" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="GenreChipsPanel"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- Рекомендуем для вас -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Рекомендуем для вас" Style="{StaticResource H2}"/>
                    <TextBlock Text="Подобрано специально для вас" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="←" Style="{StaticResource IconRoundButton}" Margin="0,0,8,0"
                            Click="RecsLeft_Click"/>
                    <Button Content="→" Style="{StaticResource IconRoundButton}" Click="RecsRight_Click"/>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="RecsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,40">
                <StackPanel x:Name="RecsRow" Orientation="Horizontal" Margin="0,0,14,0"/>
            </ScrollViewer>

            <!-- Новинки -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Новинки" Style="{StaticResource H2}"/>
                    <TextBlock Text="Свежее из коллекции" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Content="←" Style="{StaticResource IconRoundButton}" Margin="0,0,8,0"
                            Click="NewLeft_Click"/>
                    <Button Content="→" Style="{StaticResource IconRoundButton}" Click="NewRight_Click"/>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="NewScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="NewRow" Orientation="Horizontal" Margin="0,0,14,0"/>
            </ScrollViewer>

        </StackPanel>
    </ScrollViewer>
</UserControl>
