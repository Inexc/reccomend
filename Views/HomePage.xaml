<UserControl x:Class="MovieBookRecommender.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="MainScroll_SizeChanged">
        <StackPanel Margin="32,20,32,24">

            <!-- Контейнер строки поиска с выпадающим блоком результатов -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,20" Width="480">
                <Border x:Name="SearchBoxContainer"
                        Background="{StaticResource CardBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="38">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="SearchBorderBrush" Color="#2A2026"/>
                    </Border.BorderBrush>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Поиск фильмов и книг..."
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12.5"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     FontSize="12.5"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     KeyDown="SearchBox_KeyDown"/>
                        </Grid>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Width="24" Height="24" Padding="0"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                Visibility="Collapsed" Opacity="0" Click="ClearSearchBtn_Click">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}"
                                  Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Выпадающий блок быстрых результатов поиска -->
                <Popup x:Name="SearchPopup"
                       PlacementTarget="{Binding ElementName=SearchBoxContainer}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True"
                       IsOpen="False">
                    <Border Width="460"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel x:Name="DropdownContent">
                            <!-- Заголовок Поиск -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="ПОИСК" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent2Brush}"/>
                                <TextBlock x:Name="DropdownCountText" Text="Найдено: 0" Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Пустой результат -->
                            <StackPanel x:Name="DropdownEmptyState" Visibility="Collapsed" Margin="0,16,0,16" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="DropdownEmptyTranslate" X="0" Y="0"/>
                                </StackPanel.RenderTransform>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource BgSoftBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}" Width="20" Height="20"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                </Border>
                                <TextBlock Text="Ничего не найдено" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Попробуйте изменить запрос или использовать другое название."
                                           Style="{StaticResource SmallText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" Opacity="0.75"/>
                            </StackPanel>

                            <!-- Раздел Фильмы -->
                            <StackPanel x:Name="DropdownMoviesSection" Margin="0,0,0,10">
                                <TextBlock Text="ФИЛЬМЫ" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="Segoe UI Semibold" Margin="0,0,0,6"/>
                                <StackPanel x:Name="DropdownMoviesList"/>
                            </StackPanel>

                            <!-- Разделитель между фильмами и книгами -->
                            <Border x:Name="DropdownSeparator" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,2,0,10"/>

                            <!-- Раздел Книги -->
                            <StackPanel x:Name="DropdownBooksSection" Margin="0,0,0,10">
                                <TextBlock Text="КНИГИ" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="Segoe UI Semibold" Margin="0,0,0,6"/>
                                <StackPanel x:Name="DropdownBooksList"/>
                            </StackPanel>

                            <!-- Внизу: кнопки «Показать все результаты» -->
                            <Border x:Name="DropdownFooter" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ShowAllMoviesBtn" Grid.Column="0" Content="Все фильмы →"
                                            Style="{StaticResource GhostButton}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                            Click="ShowAllMoviesBtn_Click"/>
                                    <Button x:Name="ShowAllBooksBtn" Grid.Column="1" Content="Все книги →"
                                            Style="{StaticResource GhostButton}" Padding="10,6" FontSize="11" Margin="6,0,0,0"
                                            Click="ShowAllBooksBtn_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Основной контент (Hero, Рекомендуем для вас, Популярное, Новинки) -->
            <StackPanel x:Name="DefaultContentPanel">

                <!-- HERO / FEATURED БЛОК -->
                <Border x:Name="HeroFrame" CornerRadius="14" ClipToBounds="True" Height="276"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        Margin="0,0,0,22">
                    <Grid>
                        <!-- Фоновое cinematic-изображение (занимает правую часть и плавно растворяется) -->
                        <Image x:Name="HeroBgImage" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Opacity="0.22"/>

                        <!-- Мягкий рассеянный радиальный градиент-свечение от обложки в фон баннера -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="460" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.75,0.5" GradientOrigin="0.75,0.5" RadiusX="0.65" RadiusY="0.65">
                                    <GradientStop Color="#3DC1666B" Offset="0.0"/>
                                    <GradientStop Color="#22E8B4B8" Offset="0.45"/>
                                    <GradientStop Color="#001C1619" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Горизонтальное градиентное затемнение: плотный слева, мягкий полупрозрачный справа -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF1C1619" Offset="0.0"/>
                                    <GradientStop Color="#FF1C1619" Offset="0.44"/>
                                    <GradientStop Color="#E61C1619" Offset="0.62"/>
                                    <GradientStop Color="#801C1619" Offset="0.80"/>
                                    <GradientStop Color="#1A1C1619" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Вертикальный мягкий градиент сверху и снизу -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4D1C1619" Offset="0.0"/>
                                    <GradientStop Color="#001C1619" Offset="0.22"/>
                                    <GradientStop Color="#001C1619" Offset="0.78"/>
                                    <GradientStop Color="#661C1619" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Основной контент Hero: две колонки (информация слева, крупный постер справа) -->
                        <Grid Margin="24,12,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <!-- Лейбл РЕКОМЕНДУЕМ + кнопка смены -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Border Background="{StaticResource BgBrush}"
                                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconStar}" Fill="{StaticResource Accent2Brush}" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="РЕКОМЕНДУЕМ" FontSize="10" FontFamily="Segoe UI Semibold"
                                                       Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="HeroSwitchBtn" Style="{StaticResource GhostButton}"
                                            Height="24" Padding="8,0" VerticalAlignment="Center"
                                            ToolTip="Показать другую рекомендацию" Click="HeroSwitchBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextMutedBrush}" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Сменить" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Название произведения -->
                                <TextBlock x:Name="HeroTitle" Style="{StaticResource H1}" FontSize="22" LineHeight="28"
                                           Cursor="Hand" MouseLeftButtonUp="HeroPoster_MouseLeftButtonUp"
                                           TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                <!-- Жанр · ★ рейтинг · Режиссёр/Автор -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock x:Name="HeroGenresText" Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource TextBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource Accent2Brush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="★" Foreground="{StaticResource Accent2Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="HeroRatingText" Foreground="{StaticResource Accent2Brush}" FontFamily="Segoe UI Semibold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeroMetaSubText" Style="{StaticResource SmallText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <!-- Краткое описание -->
                                <TextBlock x:Name="HeroDescription" Style="{StaticResource BodyText}" FontSize="12"
                                           MaxHeight="36" LineHeight="17" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" Opacity="0.88"/>

                                <!-- Кнопки действий: строго одинаковая высота 32px -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="HeroPrimaryBtn" Style="{StaticResource AccentButton}"
                                            Height="32" Padding="18,0" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Click="HeroPrimaryBtn_Click"/>
                                    <Button x:Name="HeroFavBtn" Style="{StaticResource GhostButton}"
                                            Height="32" Padding="14,0" FontSize="12" VerticalAlignment="Center" Click="HeroFavBtn_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Правая колонка: крупный постер / обложка с сохранением пропорций, заполняющая высоту -->
                            <Border Grid.Column="1" x:Name="HeroPosterBorder"
                                    Cursor="Hand" MouseLeftButtonUp="HeroPoster_MouseLeftButtonUp"
                                    Width="174" Height="252" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Background="{StaticResource BgSoftBrush}"
                                    CornerRadius="10" ClipToBounds="True"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.55"/>
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="HeroPosterImage" Stretch="UniformToFill"/>
                                    <Border VerticalAlignment="Bottom" Height="46" Background="{StaticResource PosterFadeBrush}" Opacity="0.32"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- СЕКЦИЯ 1: РЕКОМЕНДУЕМ ДЛЯ ВАС -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Рекомендуем для вас" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="RecsSubtitle" Text="На основе ваших предпочтений" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Состояние отсутствия данных для рекомендаций (Section 16) -->
                <Border x:Name="RecsEmptyBanner" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="12" Padding="24" Margin="0,0,0,22" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconHeart}" Fill="{StaticResource TextFaintBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.7"/>
                        <TextBlock Text="Пока недостаточно данных для персонального подбора" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Добавляйте фильмы и книги в избранное, чтобы рекомендации становились точнее."
                                   Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <UniformGrid x:Name="RecsGrid" Rows="1" Columns="4" Margin="-8,0,-8,24"/>

                <!-- СЕКЦИЯ 2: ПОПУЛЯРНОЕ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Популярное" Style="{StaticResource H2}"/>
                        <TextBlock Text="Высокие оценки зрителей и читателей" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="PopularGrid" Rows="1" Columns="4" Margin="-8,0,-8,24"/>

                <!-- СЕКЦИЯ 3: НОВИНКИ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Свежее в коллекции" Style="{StaticResource H2}"/>
                        <TextBlock Text="Недавние поступления книг и фильмов" Style="{StaticResource SmallText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="NewGrid" Rows="1" Columns="4" Margin="-8,0,-8,12"/>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

