<UserControl x:Class="MovieBookRecommender.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,32,48,40">

            <!-- Контейнер строки поиска с выпадающим блоком результатов -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,28" Width="460">
                <Border x:Name="SearchBoxContainer"
                        Background="{StaticResource CardBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="42">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="SearchBorderBrush" Color="#2A2026"/>
                    </Border.BorderBrush>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Поиск фильмов и книг..."
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="13"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     FontSize="13"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     KeyDown="SearchBox_KeyDown"/>
                        </Grid>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="✕"
                                Style="{StaticResource GhostButton}" Padding="7,3" FontSize="11"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                Visibility="Collapsed" Opacity="0" Click="ClearSearchBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Выпадающий блок быстрых результатов поиска -->
                <Popup x:Name="SearchPopup"
                       PlacementTarget="{Binding ElementName=SearchBoxContainer}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True"
                       IsOpen="False">
                    <Border Width="460"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel x:Name="DropdownContent">
                            <!-- Заголовок Поиск -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="ПОИСК" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent2Brush}"/>
                                <TextBlock x:Name="DropdownCountText" Text="Найдено: 0" Style="{StaticResource SmallText}"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Пустой результат -->
                            <StackPanel x:Name="DropdownEmptyState" Visibility="Collapsed" Margin="0,16,0,16" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="DropdownEmptyTranslate" X="0" Y="0"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                                <TextBlock Text="Ничего не найдено" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Попробуйте изменить запрос или использовать другое название."
                                           Style="{StaticResource SmallText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" Opacity="0.7"/>
                            </StackPanel>

                            <!-- Раздел Фильмы -->
                            <StackPanel x:Name="DropdownMoviesSection" Margin="0,0,0,10">
                                <TextBlock Text="ФИЛЬМЫ" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="Segoe UI Semibold" Margin="0,0,0,6"/>
                                <StackPanel x:Name="DropdownMoviesList"/>
                            </StackPanel>

                            <!-- Разделитель между фильмами и книгами -->
                            <Border x:Name="DropdownSeparator" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,2,0,10"/>

                            <!-- Раздел Книги -->
                            <StackPanel x:Name="DropdownBooksSection" Margin="0,0,0,10">
                                <TextBlock Text="КНИГИ" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="Segoe UI Semibold" Margin="0,0,0,6"/>
                                <StackPanel x:Name="DropdownBooksList"/>
                            </StackPanel>

                            <!-- Внизу: кнопки «Показать все результаты» -->
                            <Border x:Name="DropdownFooter" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ShowAllMoviesBtn" Grid.Column="0" Content="Все фильмы →"
                                            Style="{StaticResource GhostButton}" Padding="10,6" FontSize="11" Margin="0,0,6,0"
                                            Click="ShowAllMoviesBtn_Click"/>
                                    <Button x:Name="ShowAllBooksBtn" Grid.Column="1" Content="Все книги →"
                                            Style="{StaticResource GhostButton}" Padding="10,6" FontSize="11" Margin="6,0,0,0"
                                            Click="ShowAllBooksBtn_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Основной контент (Hero, Избранное, Жанры, Рекомендации, Новинки) -->
            <StackPanel x:Name="DefaultContentPanel">

                <!-- Hero + правая колонка -->
                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hero -->
                    <Border x:Name="HeroFrame" Grid.Column="0" CornerRadius="16" ClipToBounds="True" Height="420">
                        <Grid>
                            <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                            <Border Background="{StaticResource HeroFadeBrush}"/>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="48,0,0,0" MaxWidth="480">
                                <StackPanel x:Name="HeroGenres" Orientation="Horizontal" Margin="0,0,0,16"/>

                                <TextBlock x:Name="HeroTitle" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock x:Name="HeroAuthor" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="·" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="★" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="HeroRating" Foreground="{StaticResource Accent2Brush}"
                                               FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="HeroDescription" Style="{StaticResource BodyText}"
                                           MaxHeight="68" TextTrimming="CharacterEllipsis" Margin="0,0,0,24"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                    <Button x:Name="HeroPrimaryBtn" Style="{StaticResource AccentButton}"
                                            Margin="0,0,12,0" Click="HeroPrimaryBtn_Click"/>
                                    <Button x:Name="HeroFavBtn" Style="{StaticResource GhostButton}"
                                            Click="HeroFavBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Правая колонка -->
                    <StackPanel Grid.Column="2">

                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ИЗБРАННОЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
                                <StackPanel x:Name="FavoritesList"/>
                                <TextBlock x:Name="FavoritesEmptyText" Style="{StaticResource SmallText}"
                                           Text="Добавляйте через ♡" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ЖАНРЫ" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="GenreChipsPanel"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <!-- Рекомендуем для вас -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Рекомендуем для вас" Style="{StaticResource H2}"/>
                        <TextBlock Text="Подобрано специально для вас" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                        <Button Content="←" Style="{StaticResource IconRoundButton}" Margin="0,0,8,0"
                                Click="RecsLeft_Click"/>
                        <Button Content="→" Style="{StaticResource IconRoundButton}" Click="RecsRight_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,40">
                    <StackPanel x:Name="RecsRow" Orientation="Horizontal" Margin="0,0,14,0"/>
                </ScrollViewer>

                <!-- Новинки -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Новинки" Style="{StaticResource H2}"/>
                        <TextBlock Text="Свежее из коллекции" Style="{StaticResource SmallText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                        <Button Content="←" Style="{StaticResource IconRoundButton}" Margin="0,0,8,0"
                                Click="NewLeft_Click"/>
                        <Button Content="→" Style="{StaticResource IconRoundButton}" Click="NewRight_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="NewScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NewRow" Orientation="Horizontal" Margin="0,0,14,0"/>
                </ScrollViewer>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

