<UserControl x:Class="MovieBookRecommender.Views.MiniCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="80" Cursor="Hand">
    <StackPanel x:Name="Root" MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Border CornerRadius="6" ClipToBounds="True" Height="110">
            <Image x:Name="PosterImage" Stretch="UniformToFill"/>
        </Border>
        <TextBlock x:Name="TitleText" Style="{StaticResource SmallText}"
                   Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
