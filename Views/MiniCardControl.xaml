<UserControl x:Class="MovieBookRecommender.Views.MiniCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="80" Cursor="Hand">
    <StackPanel x:Name="Root" MouseLeftButtonUp="Root_MouseLeftButtonUp"
                MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
                RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
            <ScaleTransform x:Name="MiniScale" ScaleX="1" ScaleY="1"/>
        </StackPanel.RenderTransform>
        <Border x:Name="PosterBorder" CornerRadius="8" ClipToBounds="True" Height="110"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Image x:Name="PosterImage" Stretch="UniformToFill"/>
        </Border>
        <TextBlock x:Name="TitleText" Style="{StaticResource SmallText}"
                   Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>

