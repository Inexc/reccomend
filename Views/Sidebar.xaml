<UserControl x:Class="MovieBookRecommender.Views.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Background="{StaticResource SidebarBrush}">
    <DockPanel LastChildFill="True">

        <StackPanel x:Name="BrandHeader" DockPanel.Dock="Top" Margin="16,20,12,20"
                    Cursor="Hand" ToolTip="На главную" MouseLeftButtonUp="BrandHeader_MouseLeftButtonUp">
            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGradient}" Margin="0,0,0,10">
                <Path Data="{StaticResource IconFilm}" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Рекомендации" FontSize="12" FontFamily="Segoe UI Semibold"
                       Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,12,20">
            <TextBlock Text="Хорошие истории" Style="{StaticResource CaptionText}" Margin="0,0,0,2"/>
            <TextBlock Text="всегда рядом" Style="{StaticResource CaptionText}"/>
        </StackPanel>

        <StackPanel x:Name="NavPanel" Margin="8,8,8,0"/>

    </DockPanel>
</UserControl>
