<UserControl x:Class="MovieBookRecommender.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,32,48,48" MaxWidth="680" HorizontalAlignment="Left">

            <!-- ЗАГОЛОВОК СТРАНИЦЫ -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Настройки" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                <TextBlock Text="Настройте приложение под себя" Style="{StaticResource BodyText}" Opacity="0.8"/>
            </StackPanel>

            <!-- 1. СЕКЦИЯ: ВНЕШНИЙ ВИД -->
            <StackPanel Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconPalette}" Fill="{StaticResource Accent2Brush}"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="14" Padding="24,20">
                    <StackPanel>
                        <!-- Настройка 1: Тема -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Тема оформления" Style="{StaticResource H3}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="Цветовая гамма и акцентные оттенки интерфейса" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="220"
                                      SelectionChanged="ThemeCombo_SelectionChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,18,0,18"/>

                        <!-- Настройка 2: Масштаб -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Размер интерфейса" Style="{StaticResource H3}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="Масштаб отображения шрифтов, отступов и карточек" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ScaleCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="220"
                                      SelectionChanged="ScaleCombo_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. СЕКЦИЯ: ПРИЛОЖЕНИЕ -->
            <StackPanel Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconSettings}" Fill="{StaticResource AccentBrush}"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="14" Padding="24,20">
                    <StackPanel>
                        <!-- Настройка 3: Автосохранение -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Автосохранение" Style="{StaticResource H3}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="Автоматически сохранять изменения темы, параметров и избранного"
                                           Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoSaveToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="AutoSaveToggle_Click"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,18,0,18"/>

                        <!-- Настройка 4: Анимации -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Анимации интерфейса" Style="{StaticResource H3}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="Использовать плавные переходы страниц, эффекты hover и микроанимации"
                                           Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="AnimationsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="AnimationsToggle_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. СЕКЦИЯ: ДАННЫЕ -->
            <StackPanel Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconHeart}" Fill="{StaticResource AccentBrush}"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ДАННЫЕ" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="14" Padding="24,20">
                    <StackPanel>
                        <!-- Настройка 5: Избранное -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Коллекция избранного" Style="{StaticResource H3}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="FavoritesCountText" Text="Сохранено элементов: 0"
                                           Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button x:Name="OpenClearDialogBtn" Grid.Column="1"
                                    Content="Очистить избранное"
                                    Style="{StaticResource OutlineDangerButton}"
                                    VerticalAlignment="Center"
                                    Click="OpenClearDialog_Click"/>
                        </Grid>

                        <!-- Встроенный аккуратный диалог подтверждения очистки (Раздел 7) -->
                        <Border x:Name="ConfirmDialog" Visibility="Collapsed"
                                Background="{StaticResource BgSoftBrush}"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16" Margin="0,16,0,0"
                                RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ConfirmTranslate" X="0" Y="-6"/>
                            </Border.RenderTransform>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource DangerBrush}"
                                          Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Очистить всё избранное?" FontSize="14" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Все сохранённые фильмы и книги будут удалены из вашей личной коллекции без возможности восстановления."
                                           Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Отмена" Style="{StaticResource GhostButton}"
                                            Padding="16,8" Margin="0,0,10,0" Click="CancelClear_Click"/>
                                    <Button Content="Да, очистить" Style="{StaticResource OutlineDangerButton}"
                                            Background="#2E1B20"
                                            Padding="16,8" Click="ConfirmClear_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. СЕКЦИЯ: О ПРИЛОЖЕНИИ -->
            <StackPanel Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconInfo}" Fill="{StaticResource Accent2Brush}"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="О ПРИЛОЖЕНИИ" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="14" Padding="24,20">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Рекомендации фильмов и книг" Style="{StaticResource H2}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="Версия 2.0" Style="{StaticResource SmallText}" Foreground="{StaticResource Accent2Brush}" FontFamily="Segoe UI Semibold"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="13" LineHeight="20"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Современное desktop-приложение для поиска, каталогизации и персональных рекомендаций фильмов и книг. Разработано на платформе C# и WPF. Все данные каталога и параметры пользователя хранятся локально в JSON."
                                   Margin="0,0,0,16"/>

                        <!-- Информационные бейджи -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock Text="C# / .NET 6.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock Text="WPF Desktop" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock Text="JSON Storage" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,8,6">
                                <TextBlock Text="100% Offline" FontSize="11" Foreground="{StaticResource Accent2Brush}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
