<UserControl x:Class="MovieBookRecommender.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="PageScroll_SizeChanged">
        <StackPanel Margin="32,20,32,28" HorizontalAlignment="Stretch">

            <!-- ЗАГОЛОВОК СТРАНИЦЫ -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Настройки" Style="{StaticResource H1}" FontSize="26" Margin="0,0,0,3"/>
                <TextBlock Text="Параметры интерфейса, темы оформления и управление коллекцией"
                           Style="{StaticResource BodyText}" FontSize="12.5" Opacity="0.8"/>
            </StackPanel>

            <!-- ОСНОВНОЙ ГРИД НАСТРОЕК (ДВЕ КОЛОНКИ С АДАПТИВНОСТЬЮ) -->
            <Grid x:Name="SettingsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="*"/>
                    <ColumnDefinition x:Name="GapCol" Width="18"/>
                    <ColumnDefinition x:Name="RightCol" Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА: ВНЕШНИЙ ВИД И РАБОТА ПРИЛОЖЕНИЯ -->
                <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0">

                    <!-- 1. СЕКЦИЯ: ВНЕШНИЙ ВИД -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconPalette}" Fill="{StaticResource Accent2Brush}"
                                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource Eyebrow}" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="12" Padding="18,14">
                            <StackPanel>
                                <!-- Настройка 1: Тема -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Тема оформления" FontSize="13.5" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Цветовая гамма и акцентные оттенки интерфейса"
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Height="32" Width="190"
                                              SelectionChanged="ThemeCombo_SelectionChanged"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,12,0,12"/>

                                <!-- Настройка 2: Масштаб -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Размер интерфейса" FontSize="13.5" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Масштаб отображения шрифтов, отступов и карточек"
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ScaleCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Height="32" Width="190"
                                              SelectionChanged="ScaleCombo_SelectionChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. СЕКЦИЯ: РАБОТА ПРИЛОЖЕНИЯ -->
                    <StackPanel Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconSettings}" Fill="{StaticResource AccentBrush}"
                                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="РАБОТА ПРИЛОЖЕНИЯ" Style="{StaticResource Eyebrow}" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="12" Padding="18,14">
                            <StackPanel>
                                <!-- Настройка 3: Автосохранение -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Автосохранение" FontSize="13.5" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Автоматически сохранять изменения темы, параметров и избранного"
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoSaveToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center" Click="AutoSaveToggle_Click"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,12,0,12"/>

                                <!-- Настройка 4: Анимации -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Анимации интерфейса" FontSize="13.5" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Использовать плавные переходы страниц, эффекты hover и микроанимации"
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AnimationsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center" Click="AnimationsToggle_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>

                <!-- ПРАВАЯ КОЛОНКА: ДАННЫЕ (ОПАСНАЯ ЗОНА) И О ПРИЛОЖЕНИИ -->
                <StackPanel x:Name="RightPanel" Grid.Column="2" Grid.Row="0">

                    <!-- 3. СЕКЦИЯ: ДАННЫЕ И ХРАНИЛИЩЕ (ОПАСНАЯ ЗОНА) -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#26171B"
                                    BorderBrush="#4D2830" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconHeart}" Fill="{StaticResource DangerBrush}"
                                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ДАННЫЕ И ХРАНИЛИЩЕ" Style="{StaticResource Eyebrow}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="#2E181D" BorderBrush="#5C2830" BorderThickness="1"
                                    CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="ОПАСНАЯ ЗОНА" FontSize="9" FontFamily="Segoe UI Bold" Foreground="#E07A85"/>
                            </Border>
                        </StackPanel>

                        <!-- Карточка с акцентной каймой опасной зоны -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="#42252C" BorderThickness="1"
                                CornerRadius="12" Padding="18,14">
                            <StackPanel>
                                <!-- Настройка 5: Избранное -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Коллекция избранного" FontSize="13.5" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="FavoritesCountText" Text="Сохранено элементов: 0"
                                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="OpenClearDialogBtn" Grid.Column="1"
                                            Content="Очистить избранное"
                                            Style="{StaticResource OutlineDangerButton}"
                                            Height="32" Padding="14,0"
                                            VerticalAlignment="Center"
                                            Click="OpenClearDialog_Click"/>
                                </Grid>

                                <!-- Встроенный аккуратный диалог подтверждения очистки -->
                                <Border x:Name="ConfirmDialog" Visibility="Collapsed"
                                        Background="#1E1418"
                                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="14,12" Margin="0,12,0,0"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ConfirmTranslate" X="0" Y="-6"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource DangerBrush}"
                                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Очистить всё избранное?" FontSize="13" FontFamily="Segoe UI Semibold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Все сохранённые фильмы и книги будут удалены из вашей личной коллекции без возможности восстановления."
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                                   LineHeight="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Отмена" Style="{StaticResource GhostButton}"
                                                    Height="30" Padding="14,0" FontSize="12" Margin="0,0,8,0" Click="CancelClear_Click"/>
                                            <Button Content="Да, очистить" Style="{StaticResource OutlineDangerButton}"
                                                    Height="30" Padding="14,0" FontSize="12"
                                                    Background="#2E1B20" Click="ConfirmClear_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. СЕКЦИЯ: О ПРИЛОЖЕНИИ -->
                    <StackPanel Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconInfo}" Fill="{StaticResource Accent2Brush}"
                                      Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="О ПРИЛОЖЕНИИ" Style="{StaticResource Eyebrow}" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="12" Padding="18,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Movie &amp; Book Recommender" FontSize="14.5" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Интеллектуальная персональная медиатека" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center"
                                            Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="v2.0" FontSize="11" FontFamily="Segoe UI Bold" Foreground="{StaticResource Accent2Brush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource BodyText}" FontSize="12" LineHeight="17"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Сервис каталогизации и персональных рекомендаций фильмов и книг. Все данные коллекции и настройки хранятся локально на вашем компьютере."
                                           Margin="0,0,0,12"/>

                                <!-- Информационные бейджи технологий -->
                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="7,3" Margin="0,0,6,4">
                                        <TextBlock Text="C# / .NET 6.0" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="7,3" Margin="0,0,6,4">
                                        <TextBlock Text="WPF Desktop" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="7,3" Margin="0,0,6,4">
                                        <TextBlock Text="JSON Storage" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="7,3" Margin="0,0,6,4">
                                        <TextBlock Text="100% Offline" FontSize="10.5" Foreground="{StaticResource Accent2Brush}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

