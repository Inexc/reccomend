<UserControl x:Class="MovieBookRecommender.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,32,48,40" MaxWidth="580">
            <TextBlock Text="Настройки" Style="{StaticResource H1}" Margin="0,0,0,8"/>
            <TextBlock Text="Управление приложением и вашими данными" Style="{StaticResource BodyText}" Opacity="0.8" Margin="0,0,0,32"/>

            <!-- Внешний вид -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="🎨" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ВНЕШНИЙ ВИД" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Тема и размер интерфейса" Style="{StaticResource SmallText}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Тема оформления" Style="{StaticResource H3}"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="160"
                                      SelectionChanged="ThemeCombo_SelectionChanged"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Размер интерфейса" Style="{StaticResource H3}"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScaleCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="160"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Избранное -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="♡" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ИЗБРАННОЕ" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Управление сохранёнными элементами" Style="{StaticResource SmallText}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Количество сохранённых элементов" Style="{StaticResource H3}"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FavoritesCountText" Grid.Column="1" FontSize="13" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource Accent2Brush}"/>
                        </Grid>
                        <Button Content="Очистить избранное" Style="{StaticResource DangerButton}"
                                Click="ClearFavorites_Click" Padding="16,9" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- О приложении -->
            <StackPanel Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="ℹ" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="О ПРИЛОЖЕНИИ" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Информация и версия" Style="{StaticResource SmallText}" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Рекомендации фильмов и книг" Style="{StaticResource H3}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Версия 2.0" Style="{StaticResource SmallText}" Opacity="0.7"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Современное desktop-приложение для поиска и рекомендаций фильмов и книг. Разработано на C# с использованием WPF. Все данные хранятся локально в формате JSON."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
