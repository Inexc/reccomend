<UserControl x:Class="MovieBookRecommender.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MovieBookRecommender.Views"
             Background="{StaticResource BgBrush}">
    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="PageScroll_SizeChanged">
        <StackPanel Margin="48,28,48,40">

            <!-- ВЕРХНИЙ ЗАГОЛОВОК -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Избранное" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                <TextBlock Text="Ваша личная коллекция фильмов и книг" Style="{StaticResource BodyText}" Opacity="0.8"/>
            </StackPanel>

            <!-- БЛОК СТАТИСТИКИ И ИНСАЙТА ВКУСА -->
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="14" Padding="24,18" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Числовые счётчики -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Разделитель -->
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="36"/>
                        <!-- Блок вкуса / Инсайт -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Всего -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ВСЕГО" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="26" FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource Accent2Brush}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="TotalScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>

                    <!-- Фильмы -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="ФИЛЬМЫ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="MoviesCountText" Text="0" FontSize="26" FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="MoviesScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>

                    <!-- Книги -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="КНИГИ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="BooksCountText" Text="0" FontSize="26" FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="BooksScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>

                    <!-- Вертикальная линия -->
                    <Border Grid.Column="6" Background="{StaticResource BorderBrush2}" Height="48" VerticalAlignment="Center"/>

                    <!-- Инсайт предпочтений -->
                    <StackPanel Grid.Column="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Path Data="{StaticResource IconStar}" Fill="{StaticResource Accent2Brush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ВАШИ ПРЕДПОЧТЕНИЯ" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="InsightBodyText"
                                   Text="Добавьте ещё несколько произведений, чтобы рекомендации стали точнее."
                                   Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap" Opacity="0.85"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ПАНЕЛЬ УПРАВЛЕНИЯ: ПЕРЕКЛЮЧАТЕЛЬ + ПОИСК + СОРТИРОВКА -->
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,24">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Переключатель типа: [ Все ] [ Фильмы ] [ Книги ] -->
                    <Border Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            CornerRadius="8" Padding="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilterAllBtn" Content="Все"
                                    Height="32" Padding="14,0" Cursor="Hand"
                                    Click="FilterBtn_Click"/>
                            <Button x:Name="FilterMoviesBtn" Content="Фильмы"
                                    Height="32" Padding="14,0" Cursor="Hand" Margin="2,0,0,0"
                                    Click="FilterBtn_Click"/>
                            <Button x:Name="FilterBooksBtn" Content="Книги"
                                    Height="32" Padding="14,0" Cursor="Hand" Margin="2,0,0,0"
                                    Click="FilterBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Поисковая строка в избранном -->
                    <Border x:Name="SearchBoxContainer"
                            Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Width="260" Height="36"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="10,0,7,0"/>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SearchPlaceholder" Text="Поиск в избранном..."
                                           Foreground="{StaticResource TextFaintBrush}" FontSize="12"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource SearchBox}"
                                         FontSize="12" Padding="2,0"
                                         VerticalAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                            <Button x:Name="ClearSearchBtn" Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Width="22" Height="22" Padding="0"
                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                    Visibility="Collapsed" Opacity="0"
                                    Click="ClearSearchBtn_Click">
                                <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}"
                                      Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Сортировка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="СОРТИРОВКА" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SortCombo" Style="{StaticResource DarkCombo}" Width="160"
                                  SelectionChanged="SortCombo_SelectionChanged">
                            <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                            <ComboBoxItem Content="По рейтингу (убыв.)"/>
                            <ComboBoxItem Content="По названию (А-Я)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Счётчик найденных в избранном -->
                    <TextBlock x:Name="ResultsCountText" Text="Показано: 0"
                               Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                </WrapPanel>
            </Border>

            <!-- КРАСИВЫЙ EMPTY STATE (КОГДА ПУСТО ИЛИ ПОИСК НЕ ДАЛ РЕЗУЛЬТАТОВ) -->
            <Border x:Name="EmptyStateBorder" Visibility="Collapsed" Margin="0,20,0,40" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="EmptyTranslate" X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path x:Name="EmptyStateIcon" Data="{StaticResource IconHeart}" Fill="{StaticResource TextFaintBrush}"
                              Width="26" Height="26" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65"/>
                    </Border>
                    <TextBlock x:Name="EmptyStateTitle" Text="Здесь пока пусто" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyStateSubtitle" Text="Добавляйте фильмы и книги в избранное, чтобы собрать свою коллекцию."
                               Style="{StaticResource BodyText}" HorizontalAlignment="Center" MaxWidth="440" TextAlignment="Center" Opacity="0.75" Margin="0,0,0,24"/>

                    <!-- Кнопки действий Empty State -->
                    <StackPanel x:Name="EmptyStateActions" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="EmptyGoMoviesBtn" Content="Найти фильм" Style="{StaticResource AccentButton}"
                                Click="GoToMovies_Click" Margin="0,0,12,0" Padding="18,10"/>
                        <Button x:Name="EmptyGoBooksBtn" Content="Найти книгу" Style="{StaticResource GhostButton}"
                                Click="GoToBooks_Click" Padding="18,10"/>
                        <Button x:Name="EmptyResetSearchBtn" Content="Сбросить поиск" Style="{StaticResource AccentButton}"
                                Visibility="Collapsed" Click="ResetSearch_Click" Padding="18,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ОСНОВНАЯ СЕТКА КАРТОЧЕК ИЗБРАННОГО -->
            <WrapPanel x:Name="CardsPanel" Orientation="Horizontal" Margin="0,0,0,20"/>

            <!-- СЕКЦИЯ: НА ОСНОВЕ ВАШЕГО ИЗБРАННОГО (ПЕРСОНАЛЬНЫЕ РЕКОМЕНДАЦИИ БЕЗ ДУБЛИКАТОВ) -->
            <StackPanel x:Name="RecommendationsSection" Margin="0,20,0,10">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="На основе вашего избранного" Style="{StaticResource H2}"/>
                        <TextBlock Text="Новые произведения, подобранные под ваш вкус" Style="{StaticResource SmallText}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <UniformGrid x:Name="RecsGrid" Rows="1" Columns="4"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

