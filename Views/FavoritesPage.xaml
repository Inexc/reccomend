<UserControl x:Class="MovieBookRecommender.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="48,32,48,28">
            <TextBlock Text="❤ Избранное" Style="{StaticResource H1}" Margin="0,0,0,8"/>
            <TextBlock Text="То, что вы хотите посмотреть или прочитать позже" Style="{StaticResource BodyText}" Opacity="0.8"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" CornerRadius="12" Margin="48,0,48,20" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Фильмы" Style="{StaticResource SmallText}" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="MoviesCountText" FontSize="18" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="40,0,0,0">
                    <TextBlock Text="Книги" Style="{StaticResource SmallText}" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="BooksCountText" FontSize="18" FontFamily="Segoe UI Semibold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="40,0,0,0">
                    <TextBlock Text="Всего" Style="{StaticResource SmallText}" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TotalCountText" FontSize="18" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Accent2Brush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="48,0,48,20">
            <Button x:Name="FilterAllBtn" Content="Все" Style="{StaticResource GenreChip}" Click="Filter_Click" Margin="0,0,8,0"/>
            <Button x:Name="FilterMoviesBtn" Content="Фильмы" Style="{StaticResource GenreChip}" Click="Filter_Click" Margin="0,0,8,0"/>
            <Button x:Name="FilterBooksBtn" Content="Книги" Style="{StaticResource GenreChip}" Click="Filter_Click"/>
        </StackPanel>

        <Border x:Name="EmptyState" DockPanel.Dock="Top" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                <TextBlock Text="♡" FontSize="48" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Здесь пока ничего нет" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Добавляйте фильмы и книги в избранное, чтобы быстро найти их позже." Style="{StaticResource BodyText}" HorizontalAlignment="Center" MaxWidth="380" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" Margin="48,0,48,40"
                      SizeChanged="CardsScroll_SizeChanged">
            <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
