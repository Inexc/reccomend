<UserControl x:Class="MovieBookRecommender.Views.CardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Cursor="Hand"
             SizeChanged="CardControl_SizeChanged">
    <Border x:Name="RootBorder" Background="Transparent"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp"
            MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border x:Name="PosterFrame" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="12" Height="259">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadowEffect" Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.22" RenderingBias="Performance"/>
            </Border.Effect>
            <Grid>
                <!-- 1. Fallback слой (элегантная эмблема-заглушка вместо гигантских букв) -->
                <Grid x:Name="FallbackContainer" Visibility="Collapsed">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2D2128" Offset="0.0"/>
                                <GradientStop Color="#20171C" Offset="0.45"/>
                                <GradientStop Color="#171114" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Центральный стильный бейдж-эмблема -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,32">
                        <Border Width="46" Height="46" CornerRadius="12"
                                Background="#33242B" BorderBrush="#4A343F" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35" RenderingBias="Performance"/>
                            </Border.Effect>
                            <Path x:Name="FallbackIcon" Data="{StaticResource IconFilm}" Fill="{StaticResource AccentBrush}"
                                  Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="FallbackKindText" Text="ФИЛЬМ" FontSize="10" FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource TextMutedBrush}" Opacity="0.75"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Изображение постера -->
                <Image x:Name="PosterImage" Stretch="UniformToFill"/>

                <!-- 3. Светящийся мягкий оверлей при hover -->
                <Border x:Name="BrightenOverlay" Background="White" Opacity="0" IsHitTestVisible="False"/>

                <!-- 4. Кинематографичный тёмный градиент для текста снизу -->
                <Border x:Name="BottomGradient" VerticalAlignment="Bottom" Height="142" Background="{StaticResource PosterFadeBrush}" Opacity="0.94" IsHitTestVisible="False"/>

                <!-- 5. Компактная кнопка избранного поверх постера (верхний правый угол) -->
                <Border x:Name="HeartBadge" Width="28" Height="28" CornerRadius="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                        Cursor="Hand"
                        MouseLeftButtonDown="HeartBadge_MouseLeftButtonDown"
                        MouseLeftButtonUp="FavIcon_MouseLeftButtonUp"
                        MouseEnter="HeartBadge_MouseEnter" MouseLeave="HeartBadge_MouseLeave"
                        Opacity="0.80" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <SolidColorBrush x:Name="HeartBrush" Color="#DD161114"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="HeartBorderBrush" Color="#33FFFFFF"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <TextBlock x:Name="FavIcon" Text="♡" FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold" Margin="0,0,0,1"/>
                </Border>

                <!-- 6. Информационный блок с чёткой типографической иерархией -->
                <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10" IsHitTestVisible="False">
                    <!-- Верхняя строка метаданных: Жанр слева, Рейтинг справа -->
                    <Grid Margin="0,0,0,2">
                        <TextBlock x:Name="GenreText" FontSize="10.5" FontFamily="Segoe UI Semibold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,42,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="11" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBlock x:Name="RatingText" FontSize="11.5" FontFamily="Segoe UI Bold"
                                       Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Название произведения (чёткий акцент, максимум 2 строки) -->
                    <TextBlock x:Name="TitleText" FontSize="13" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               MaxHeight="36" LineHeight="17" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,2"/>

                    <!-- Автор или Режиссёр (аккуратный приглушённый подзаголовок) -->
                    <TextBlock x:Name="SubtitleText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                               Opacity="0.88" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 7. Рамка выделения (Selected State) -->
                <Border x:Name="SelectedBorder" CornerRadius="12" BorderThickness="2"
                        BorderBrush="{StaticResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
