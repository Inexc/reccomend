<UserControl x:Class="MovieBookRecommender.Views.CardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Cursor="Hand">
    <Border x:Name="RootBorder" Background="Transparent"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp"
            MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Border x:Name="PosterFrame" Background="{StaticResource CardBrush}"
                CornerRadius="12" ClipToBounds="True" Height="256">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadowEffect" Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <Image x:Name="PosterImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>

                <Border x:Name="BrightenOverlay" Background="White" Opacity="0"/>

                <Border x:Name="BottomGradient" VerticalAlignment="Bottom" Height="136" Background="{StaticResource PosterFadeBrush}" Opacity="0.88"/>

                <Border x:Name="HeartBadge" Width="28" Height="28" CornerRadius="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                        Cursor="Hand" MouseLeftButtonUp="FavIcon_MouseLeftButtonUp"
                        MouseEnter="HeartBadge_MouseEnter" MouseLeave="HeartBadge_MouseLeave"
                        Opacity="0.75" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <SolidColorBrush x:Name="HeartBrush" Color="#DD161114"/>
                    </Border.Background>
                    <TextBlock x:Name="FavIcon" Text="♡" FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI Semibold" Margin="0,0,0,1"/>
                </Border>

                <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                    <TextBlock x:Name="TitleText" FontSize="14" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               MaxHeight="36" LineHeight="18" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,3,0,3" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="RatingText" FontSize="11.5" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource Accent2Brush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
