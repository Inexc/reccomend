<UserControl x:Class="MovieBookRecommender.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="48,32,48,24">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,8"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}" Opacity="0.8"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="48,0,48,24">
            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" MinWidth="240"
                    VerticalAlignment="Bottom" Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                         TextChanged="Filter_Changed" Padding="0,12" FontSize="13"
                         Foreground="{StaticResource TextBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,0">
                <TextBlock Text="ЖАНР" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GenreCombo" Style="{StaticResource DarkCombo}" Width="140"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="СОРТИРОВКА" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SortCombo" Style="{StaticResource DarkCombo}" Width="140"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" Margin="48,0,48,40"
                      SizeChanged="CardsScroll_SizeChanged">
            <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

    </DockPanel>
</UserControl>
