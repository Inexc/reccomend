<UserControl x:Class="MovieBookRecommender.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="48,32,48,24">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,8"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}" Opacity="0.8"/>
        </StackPanel>

        <!-- Панель управления (Единый Control Bar) -->
        <Border DockPanel.Dock="Top" Margin="48,0,48,24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Контейнер поиска -->
                <Border x:Name="SearchBoxContainer"
                        Background="{StaticResource BgBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="270"
                        Height="38"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="SearchBorderBrush" Color="#2A2026"/>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="11,0,8,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder" Text="Поиск..."
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     FontSize="12"
                                     Padding="2,0"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"/>
                        </Grid>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Width="24" Height="24" Padding="0"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="Collapsed" Opacity="0"
                                Click="ClearSearchBtn_Click">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}"
                                  Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Фильтр Жанра -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="ЖАНР" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="GenreCombo" Style="{StaticResource DarkCombo}" Width="160"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="СОРТИРОВКА" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SortCombo" Style="{StaticResource DarkCombo}" Width="160"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Кнопка «Сбросить» (появляется при изменении фильтров) -->
                <Button x:Name="ResetFiltersBtn"
                        Style="{StaticResource GhostButton}"
                        Height="38"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Visibility="Collapsed"
                        Click="ResetFiltersBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Сбросить" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Счётчик найденных элементов -->
                <TextBlock x:Name="ResultsCountText"
                           Text="Найдено: 0"
                           Style="{StaticResource SmallText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="48,0,48,40" SizeChanged="CardsScroll_SizeChanged">
            <Grid>
                <!-- Состояние «Ничего не найдено» -->
                <Border x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="EmptyTranslate" X="0" Y="0"/>
                    </Border.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}" Width="24" Height="24" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                        </Border>
                        <TextBlock Text="Ничего не найдено" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Попробуйте изменить запрос или использовать другое название."
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.75" Margin="0,0,0,16"/>
                        <Button Content="Сбросить фильтры" Style="{StaticResource GhostButton}" Click="ResetFiltersBtn_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
