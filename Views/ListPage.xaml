<UserControl x:Class="MovieBookRecommender.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="48,32,48,24">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,8"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}" Opacity="0.8"/>
        </StackPanel>

        <!-- Панель управления (Единый Control Bar) -->
        <Border DockPanel.Dock="Top" Margin="48,0,48,24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Контейнер поиска -->
                <Border x:Name="SearchBoxContainer"
                        Background="{StaticResource BgBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="270"
                        Height="38"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                   VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder" Text="Поиск..."
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"/>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     FontSize="12"
                                     Padding="2,0"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"/>
                        </Grid>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="✕"
                                Style="{StaticResource GhostButton}"
                                Padding="6,2" FontSize="10"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Click="ClearSearchBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Фильтр Жанра -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="ЖАНР" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="GenreCombo" Style="{StaticResource DarkCombo}" Width="160"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="СОРТИРОВКА" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SortCombo" Style="{StaticResource DarkCombo}" Width="160"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Кнопка «Сбросить» (появляется при изменении фильтров) -->
                <Button x:Name="ResetFiltersBtn"
                        Content="✕  Сбросить"
                        Style="{StaticResource GhostButton}"
                        Height="38"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Visibility="Collapsed"
                        Click="ResetFiltersBtn_Click"/>

                <!-- Счётчик найденных элементов -->
                <TextBlock x:Name="ResultsCountText"
                           Text="Найдено: 0"
                           Style="{StaticResource SmallText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" Margin="48,0,48,40"
                      SizeChanged="CardsScroll_SizeChanged">
            <Grid>
                <!-- Состояние «Ничего не найдено» -->
                <Border x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,14" Opacity="0.6"/>
                        <TextBlock Text="Ничего не найдено" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Попробуйте изменить запрос или использовать другое название."
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.7" Margin="0,0,0,16"/>
                        <Button Content="Сбросить фильтры" Style="{StaticResource GhostButton}" Click="ResetFiltersBtn_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
