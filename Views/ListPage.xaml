<UserControl x:Class="MovieBookRecommender.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="32,22,32,14">
            <TextBlock x:Name="TitleText" FontSize="26" FontFamily="Segoe UI Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
            <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <!-- Панель управления (Единый компактный Control Bar) -->
        <Border DockPanel.Dock="Top" Margin="32,0,32,18"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: Поиск + Разделитель + Фильтры + Сброс в одну строгую линию -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Контейнер поиска -->
                    <Border x:Name="SearchBoxContainer"
                            Background="{StaticResource BgBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Width="230"
                            Height="34"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="SearchBorderBrush" Color="#2A2026"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="10,0,7,0"/>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SearchPlaceholder" Text="Поиск..."
                                           Foreground="{StaticResource TextFaintBrush}"
                                           FontSize="12"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"/>
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource SearchBox}"
                                         FontSize="12"
                                         Padding="2,0"
                                         VerticalAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                            <Button x:Name="ClearSearchBtn" Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Width="22" Height="22" Padding="0"
                                    VerticalAlignment="Center" Margin="0,0,5,0"
                                    Visibility="Collapsed" Opacity="0"
                                    Click="ClearSearchBtn_Click">
                                <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}"
                                      Width="8.5" Height="8.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Тонкий разделитель -->
                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush2}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                    <!-- Фильтр Жанра -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="ЖАНР" Style="{StaticResource Eyebrow}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="GenreCombo" Style="{StaticResource DarkCombo}" Height="34" Width="145"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- Сортировка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="СОРТИРОВКА" Style="{StaticResource Eyebrow}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SortCombo" Style="{StaticResource DarkCombo}" Height="34" Width="145"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- Кнопка «Сбросить» (появляется при изменении фильтров) -->
                    <Button x:Name="ResetFiltersBtn"
                            Style="{StaticResource GhostButton}"
                            Height="34"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="ResetFiltersBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Сбросить" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Правая часть: Счётчик найденных элементов (аккуратный неброский бейдж) -->
                <Border Grid.Column="1" VerticalAlignment="Center"
                        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="6" Padding="8,4">
                    <TextBlock x:Name="ResultsCountText"
                               Text="Найдено: 0"
                               FontSize="11"
                               FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource TextFaintBrush}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="32,0,32,20" SizeChanged="CardsScroll_SizeChanged">
            <Grid>
                <!-- Состояние «Ничего не найдено» -->
                <Border x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="EmptyTranslate" X="0" Y="0"/>
                    </Border.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource TextFaintBrush}" Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                        </Border>
                        <TextBlock Text="Ничего не найдено" Style="{StaticResource H2}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Попробуйте изменить запрос или сбросить фильтры."
                                   Style="{StaticResource BodyText}" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.75" Margin="0,0,0,14"/>
                        <Button Content="Сбросить фильтры" Style="{StaticResource GhostButton}" Height="32" Padding="14,0" FontSize="12" Click="ResetFiltersBtn_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Равномерная адаптивная сетка карточек -->
                <UniformGrid x:Name="CardsPanel" Columns="4" Margin="-8,0,-8,20"/>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
