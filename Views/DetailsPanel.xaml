<UserControl x:Class="MovieBookRecommender.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="280" Background="{StaticResource BgSoftBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="18,18,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderTitle" Grid.Column="0" Text="ПОДБОР ДЛЯ ВАС" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonUp="Refresh_MouseLeftButtonUp">
                <Border.ToolTip>
                    <ToolTip Content="Новая рекомендация"/>
                </Border.ToolTip>
                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Margin="18,0,18,18" RenderTransformOrigin="0.5,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
                </StackPanel.RenderTransform>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
