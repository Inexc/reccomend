<UserControl x:Class="MovieBookRecommender.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="280" Background="{StaticResource BgSoftBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="18,18,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ПОДБОР ДЛЯ ВАС" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="⟳" FontSize="12" Cursor="Hand"
                       Foreground="{StaticResource TextMutedBrush}"
                       MouseLeftButtonUp="Refresh_MouseLeftButtonUp">
                <TextBlock.ToolTip>
                    <ToolTip Content="Новая рекомендация"/>
                </TextBlock.ToolTip>
            </TextBlock>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Margin="18,0,18,18" RenderTransformOrigin="0.5,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
                </StackPanel.RenderTransform>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
