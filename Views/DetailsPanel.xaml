<UserControl x:Class="MovieBookRecommender.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="244" Background="{StaticResource BgSoftBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" Margin="14,14,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderTitle" Grid.Column="0" Text="ПОДБОР ДЛЯ ВАС" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
            <Border x:Name="RefreshButton" Grid.Column="1" Width="24" Height="24" CornerRadius="6" Background="Transparent" Cursor="Hand"
                    Focusable="True" MouseLeftButtonUp="Refresh_MouseLeftButtonUp" KeyDown="Refresh_KeyDown"
                    GotKeyboardFocus="Refresh_GotKeyboardFocus" LostKeyboardFocus="Refresh_LostKeyboardFocus">
                <Border.ToolTip>
                    <ToolTip Content="Новая рекомендация"/>
                </Border.ToolTip>
                <Path x:Name="RefreshIcon" Data="{StaticResource IconRefresh}" Fill="{StaticResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="14,0,14,16" RenderTransformOrigin="0.5,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
                </StackPanel.RenderTransform>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
