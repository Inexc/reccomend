<Window x:Class="MovieBookRecommender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MovieBookRecommender.Views"
        Title="Рекомендации фильмов и книг"
        Width="1400" Height="850" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="AppScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="244"/>
        </Grid.ColumnDefinitions>

        <views:Sidebar x:Name="SidebarControl" Grid.Column="0" Navigate="SidebarControl_Navigate"/>

        <Grid Grid.Column="1" x:Name="CenterHost" Background="{StaticResource BgBrush}"/>

        <views:DetailsPanel x:Name="DetailsPanelControl" Grid.Column="2"/>

        <!-- Всплывающее уведомление (Toast) -->
        <Border x:Name="ToastContainer" Grid.Column="1"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,32"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="20,10"
                Opacity="0"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" X="0" Y="10"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToastIcon" Text="✓" FontSize="14" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ToastMessage" Text="Уведомление" FontSize="13" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" FontFamily="Segoe UI Medium"/>
            </StackPanel>
        </Border>

        <!-- Индикатор первичной загрузки постеров -->
        <Border x:Name="LoadingOverlay" Grid.ColumnSpan="3" Background="#CC111827" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка обложек…" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="Это займёт несколько секунд" Foreground="#A3ADC2" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
